model Booking {

  id             String        @id @default(uuid())
  customerId     String
  technicianId   String
  serviceId      String
  bookingDate    DateTime

  slot           String

  status         BookingStatus @default(REQUESTED)
  totalAmount    Float

  availabilityId String

  note           String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer User @relation("CustomerBookings", fields: [customerId], references: [id])

  technician User @relation("TechnicianBookings", fields: [technicianId], references: [id])

  service Service @relation(fields: [serviceId], references: [id])

  availability technicianAvailability @relation( fields: [availabilityId],references: [id] )
  payment Payment?

  review Review?
  @@unique([availabilityId, slot])
  @@index([customerId])
  @@index([technicianId])
  @@index([serviceId])
  @@index([status])
  @@index([bookingDate])
  @@index([customerId, status])
  @@index([technicianId, status])
  @@index([technicianId, bookingDate])

  @@map("bookings")
}
