model Service {

  id            String   @id @default(uuid())

  title         String

  description   String

  img String?

  price         Float

  duration      Int

  technicianId  String

  categoryId    String

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt

  technician User @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id])

  bookings Booking[]

  @@index([technicianId])
  @@index([categoryId])
  @@index([price])
  @@index([createdAt])
  @@index([categoryId, price])
  @@index([technicianId, categoryId])

  @@map("services")
}
